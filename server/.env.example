# MongoDB connection string. Atlas (free tier is fine) supports the
# transactions PayLite needs; a single local mongod does not.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/paylite?retryWrites=true&w=majority

# Long random string, e.g. from:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d

PORT=5000

# Frontend URLs allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:5173

# Razorpay (optional). With test-mode keys, "Add money" opens real Razorpay
# checkout. Without them, top-ups run in demo mode.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
# Set this in Razorpay Dashboard -> Webhooks for
#   https://<your-api>/api/webhooks/razorpay  (events: payment.captured)
RAZORPAY_WEBHOOK_SECRET=
